{
  "authority_id": "UIP_NATIVE_METALS_VEHICLE_RANKING_V1",
  "schema_version": "1.0.0",
  "methodology_version": "1.2.0",
  "scope": "REGISTERED_METALS_IMPLEMENTATION_VEHICLES_ONLY",
  "ranking_grain": "ONE_ROW_PER_REGISTERED_ENABLED_VEHICLE_GROUPED_WITHIN_ONE_COMMODITY",
  "weights": {
    "exposure_fidelity": 0.35,
    "cost_efficiency": 0.25,
    "liquidity_implementation_friction": 0.25,
    "risk_efficiency": 0.15
  },
  "normalization": {
    "comparison_scope": "WITHIN_SAME_COMMODITY_GROUP_ONLY",
    "score_range": [0.0, 100.0],
    "cost_efficiency": {
      "direction": "LOWER_IS_BETTER",
      "formula": "100 * group_min_expense_ratio / vehicle_expense_ratio"
    },
    "liquidity_implementation_friction": {
      "adv_subweight": 0.50,
      "spread_subweight": 0.50,
      "adv_direction": "HIGHER_IS_BETTER",
      "adv_formula": "100 * vehicle_average_dollar_volume / group_max_average_dollar_volume",
      "spread_direction": "LOWER_IS_BETTER",
      "spread_formula": "100 * group_min_bid_ask_spread / vehicle_bid_ask_spread",
      "component_formula": "0.50 * adv_score + 0.50 * spread_score"
    },
    "risk_efficiency": {
      "submetrics": [
        "volatility",
        "downside_volatility",
        "maximum_drawdown_magnitude",
        "value_at_risk"
      ],
      "submetric_weights": {
        "volatility": 0.25,
        "downside_volatility": 0.25,
        "maximum_drawdown_magnitude": 0.25,
        "value_at_risk": 0.25
      },
      "direction": "LOWER_IS_BETTER",
      "submetric_formula": "100 * group_min_positive_value / vehicle_positive_value",
      "maximum_drawdown_transform": "ABSOLUTE_VALUE",
      "component_formula": "arithmetic mean of the four risk submetric scores"
    },
    "total_formula": "0.35 * exposure_fidelity + 0.25 * cost_efficiency + 0.25 * liquidity_implementation_friction + 0.15 * risk_efficiency",
    "single_vehicle_group_policy": "DO_NOT_RANK_LABEL_ONLY_REGISTERED_IMPLEMENTATION",
    "zero_or_nonpositive_required_input_policy": "FAIL_CLOSED",
    "missing_required_input_policy": "FAIL_CLOSED",
    "rounding_policy": "retain full precision for ordering; round only for display"
  },
  "optional_informational_evidence": [
    "tracking_quality"
  ],
  "exposure_fidelity_class_scores": {
    "physical_backed_etf": 100,
    "futures_fund": 90,
    "miners_etf": 60,
    "thematic_equity_etf": 55
  },
  "required_evidence": [
    "registered_exposure_type",
    "expense_ratio",
    "average_dollar_volume",
    "bid_ask_spread",
    "vehicle_risk_v1"
  ],
  "preferred_vehicle_gate": {
    "require_upstream_commodity_actionable": true,
    "require_complete_evidence_for_all_compared_vehicles": true,
    "require_ranking_audit_pass": true,
    "missing_values_may_default": false,
    "single_vehicle_label": "ONLY_REGISTERED_IMPLEMENTATION",
    "multi_vehicle_missing_evidence_label": "PREFERRED_VEHICLE_NOT_CERTIFIED",
    "preferred_label": "PREFERRED_IMPLEMENTATION_CANDIDATE"
  },
  "tie_break_order": [
    "higher_exposure_fidelity",
    "lower_bid_ask_spread",
    "lower_expense_ratio",
    "lower_maximum_drawdown_magnitude",
    "lexical_ticker_display_fallback_only"
  ],
  "forbidden": [
    "cross_commodity_vehicle_ranking",
    "vehicle_risk_as_commodity_risk",
    "vehicle_return_as_commodity_forecast",
    "commodity_expected_return_as_vehicle_forecast",
    "representative_test_score_as_live_authority",
    "tracking_proxy_substitution",
    "missing_evidence_default",
    "automatic_execution",
    "position_sizing",
    "portfolio_allocation"
  ]
}
