{
  "authority_id": "UIP_NATIVE_METALS_VEHICLE_RANKING_V1",
  "schema_version": "1.0.0",
  "methodology_version": "1.0.0",
  "scope": "REGISTERED_METALS_IMPLEMENTATION_VEHICLES_ONLY",
  "ranking_grain": "ONE_ROW_PER_REGISTERED_ENABLED_VEHICLE_GROUPED_WITHIN_ONE_COMMODITY",
  "weights": {
    "exposure_fidelity": 0.30,
    "cost_efficiency": 0.20,
    "liquidity_implementation_friction": 0.20,
    "tracking_quality": 0.15,
    "risk_efficiency": 0.15
  },
  "exposure_fidelity_class_scores": {
    "physical_backed_etf": 100,
    "futures_fund": 90,
    "miners_etf": 60,
    "thematic_equity_etf": 55
  },
  "required_evidence": [
    "registered_exposure_type",
    "expense_ratio",
    "average_dollar_volume",
    "bid_ask_spread",
    "tracking_quality_or_explicit_not_applicable_state",
    "vehicle_risk_v1"
  ],
  "preferred_vehicle_gate": {
    "require_upstream_commodity_actionable": true,
    "require_complete_evidence_for_all_compared_vehicles": true,
    "require_ranking_audit_pass": true,
    "missing_values_may_default": false,
    "single_vehicle_label": "ONLY_REGISTERED_IMPLEMENTATION",
    "multi_vehicle_missing_evidence_label": "PREFERRED_VEHICLE_NOT_CERTIFIED",
    "preferred_label": "PREFERRED_IMPLEMENTATION_CANDIDATE"
  },
  "tie_break_order": [
    "higher_exposure_fidelity",
    "lower_bid_ask_spread",
    "lower_expense_ratio",
    "lower_maximum_drawdown_magnitude",
    "lexical_ticker_display_fallback_only"
  ],
  "forbidden": [
    "cross_commodity_vehicle_ranking",
    "vehicle_risk_as_commodity_risk",
    "vehicle_return_as_commodity_forecast",
    "commodity_expected_return_as_vehicle_forecast",
    "representative_test_score_as_live_authority",
    "missing_evidence_default",
    "automatic_execution",
    "position_sizing",
    "portfolio_allocation"
  ]
}