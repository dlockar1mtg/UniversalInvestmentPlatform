          "_manifest_sha256",
          "_imported_at_utc"
        ]
      },
      "native_rank_available": false,
      "current_price_contract": "NOT_BOUND_IN_DASH_READ_1_GENERIC_SURFACE"
    },
    "metals": {
      "authority_mode": "GENERIC_CURRENT_VIEWS",
      "platform_id": "metals",
      "asset_surface": {"source": "asset_master_current", "inherit_required_fields_from": "crypto.asset_surface"},
      "recommendation_surface": {"source": "recommendations_current", "inherit_required_fields_from": "crypto.recommendation_surface"},
      "forecast_surface": {"source": "forecasts_current", "inherit_required_fields_from": "crypto.forecast_surface"},
      "risk_surface": {"source": "risk_metrics_current", "inherit_required_fields_from": "crypto.risk_surface"},
      "native_rank_available": false,
      "current_price_contract": "NOT_BOUND_IN_DASH_READ_1_GENERIC_SURFACE"
    },
    "mtg": {
      "authority_mode": "MTG_NATIVE_CURRENT_ONLY",
      "platform_id": "mtg",
      "native_surface": {
        "source": "mtg_native_authority_current",
        "required_fields": [
          "mtg_asset_id",
          "mtg_lane",
          "native_asset_id",
          "product_name",
          "lane_authority_state",
          "current_price_usd",
          "current_price_authority_available",
          "forecast_authority_available",
          "forecast_1y_price_usd",
          "forecast_1y_return",
          "risk_authority_available",
          "native_rank",
          "native_rank_type",
          "native_purchase_status",
          "purchase_semantic",
          "evidence_state",
          "actionability_state",
          "execution_ready_purchase_certified",
          "manual_execution_price_check_required",
          "native_authority_pointer",
          "native_authority_sha256",
          "snapshot_population_is_permanent",
          "automatic_purchase_execution",
          "_import_id",
          "_package_id",
          "_source_platform",
          "_source_filename",
          "_source_row_number",
          "_manifest_sha256",
          "_imported_at_utc"
        ]
      },
      "generic_current_authority_must_be_zero": [
        "asset_master_current",
        "forecasts_current",
        "recommendations_current",
        "risk_metrics_current"
      ],
      "native_rank_available": true,
      "current_price_contract": "NATIVE_CURRENT_PRICE_WHEN_AUTHORITY_AVAILABLE"
    }
  },
  "render_read_api_surfaces": [
    "global_status",
    "recommendations",
    "asset_detail",
    "domain_health",
    "lineage"
  ],
  "application_state_not_part_of_dash_read_1": [
