          "_manifest_sha256",
          "_imported_at_utc"
        ]
      },
      "forecast_surface": {
        "source": "forecasts_current",
        "required_fields": [
          "universal_asset_id",
          "platform_id",
          "forecast_origin_date",
          "forecast_horizon_months",
          "forecast_method",
          "point_forecast",
          "lower_bound",
          "upper_bound",
          "expected_return",
          "probability_positive",
          "confidence_score",
          "scenario",
          "source_system",
          "model_version",
          "generated_at_utc",
          "metadata_json",
          "run_id",
          "_import_id",
          "_package_id",
          "_manifest_sha256",
          "_imported_at_utc"
        ]
      },
      "risk_surface": {
        "source": "risk_metrics_current",
        "required_fields": [
          "universal_asset_id",
          "platform_id",
          "risk_score",
          "risk_level",
          "volatility",
          "downside_volatility",
          "maximum_drawdown",
