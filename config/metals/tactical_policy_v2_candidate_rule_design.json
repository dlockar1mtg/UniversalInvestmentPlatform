{
  "design_id": "METALS-TACTICAL-POLICY-V2-CANDIDATE-RULE-DESIGN-1",
  "version": "1.0.0",
  "source_research_design": "METALS-TACTICAL-POLICY-V2-RESEARCH-DESIGN-1",
  "source_v1_candidate": "METALS-TACTICAL-POLICY-CANDIDATE-RULE-DESIGN-1",
  "domain_id": "metals",
  "objective": "Lock a revised falsifiable Metals tactical candidate before any new unseen validation history is acquired or inspected.",
  "eligible_vehicle_asset_ids": [
    "metals:vehicle:COPX",
    "metals:vehicle:CPER",
    "metals:vehicle:GLD",
    "metals:vehicle:IAU",
    "metals:vehicle:PPLT",
    "metals:vehicle:SGOL",
    "metals:vehicle:SIVR",
    "metals:vehicle:SLV",
    "metals:vehicle:URA",
    "metals:vehicle:URNM"
  ],
  "reference_control_asset_ids": ["metals:vehicle:BIL"],
  "candidate_postures": ["ACCUMULATE", "HOLD", "WATCH", "REDUCE", "AVOID"],
  "historical_validation_input_scope": {
    "time_aligned_price_derived_inputs_only": true,
    "required_price_derived_inputs": [
      "return_1m_pct",
      "return_3m_pct",
      "return_6m_pct",
      "distance_ma50_pct",
      "distance_ma200_pct",
      "current_drawdown_pct",
      "realized_volatility_3m_pct"
    ],
    "current_only_recommendation_or_risk_may_not_be_backfilled_into_history": true,
    "missing_historical_vintage_authority_must_remain_missing": true
  },
  "v2_candidate_signal_rules": {
    "return_1m": {"positive_if_gte": 2.0, "negative_if_lte": -1.0, "weight": 1},
    "return_3m": {"positive_if_gte": 5.0, "negative_if_lte": -3.0, "weight": 2},
    "return_6m": {"positive_if_gte": 8.0, "negative_if_lte": -5.0, "weight": 2},
    "distance_ma50": {"positive_if_gte": 2.0, "negative_if_lte": -1.0, "weight": 1},
    "distance_ma200": {"positive_if_gte": 3.0, "negative_if_lte": -2.0, "weight": 2},
    "drawdown_penalty": {
      "penalty_1_if_lte": -10.0,
      "penalty_2_if_lte": -20.0
    },
    "volatility_penalty": {
      "penalty_1_if_gte": 40.0
    }
  },
  "v2_candidate_score_mapping": {
    "ACCUMULATE": {"minimum_score": 4},
    "HOLD": {"minimum_score": 2, "maximum_score": 3},
    "WATCH": {"minimum_score": 0, "maximum_score": 1},
    "REDUCE": {"minimum_score": -3, "maximum_score": -1},
    "AVOID": {"maximum_score": -4}
  },
  "v2_change_rationale": {
    "negative_signal_sensitivity_increased": true,
    "defensive_score_region_broadened_to_include_minus_one": true,
    "positive_signal_thresholds_preserved_where_practical": true,
    "changes_use_consumed_v1_findings_as_research_only": true,
    "no_new_unseen_validation_outcomes_used": true,
    "objective_is_sufficient_defensive_support_without_lowering_support_floor": true
  },
  "validation_requirements": {
    "minimum_compared_group_support": 20,
    "forward_horizons_observations": [21, 63],
    "walk_forward_step_observations": 5,
    "constructive_group": ["ACCUMULATE", "HOLD"],
    "defensive_group": ["REDUCE", "AVOID"],
    "constructive_63d_median_return_must_exceed_defensive": true,
    "constructive_63d_positive_return_rate_must_exceed_defensive": true,
    "defensive_63d_mean_maximum_adverse_excursion_must_be_more_negative_than_constructive": true,
    "holdout_posture_change_rate_maximum": 0.50,
    "new_validation_interval_must_be_disjoint_from_v1": true,
    "candidate_rules_locked_before_new_validation_history_collection": true,
    "candidate_rules_locked_before_new_validation_outcome_inspection": true
  },
  "hard_gates": {
    "reference_control_receives_no_opportunity_posture": true,
    "minimum_history_observations": 252,
    "all_required_price_derived_inputs_must_be_available": true,
    "current_application_requires_current_price_authority": true,
    "current_application_requires_recommendation_and_risk_authority": true,
    "insufficient_current_authority_yields_no_tactical_posture": true
  },
  "semantic_constraints": {
    "defensive_signal_is_downside_warning": true,
    "more_negative_future_mae_is_evidence_consistent_with_defensive_warning": true,
    "momentum_state_is_descriptive_not_predictive": true,
    "candidate_policy_is_not_yet_authorized_advice": true,
    "forecast_validation_separate_from_policy_validation": true,
    "cross_domain_rank_prohibited": true,
    "universal_allocation_policy_prohibited": true,
    "automatic_execution_prohibited": true
  },
  "controls": {
    "v2_candidate_rule_design_authorized": true,
    "historical_expansion_feasibility_audit_authorized": false,
    "historical_expansion_execution_authorized": false,
    "new_validation_outcome_inspection_authorized": false,
    "historical_candidate_evaluation_authorized": false,
    "tactical_posture_authorized": false,
    "presentation_activation_authorized": false,
    "production_database_write_authorized": false,
    "forecast_refresh_authorized": false,
    "model_retraining_authorized": false,
    "cross_domain_rank_authorized": false,
    "allocation_policy_authorized": false,
    "automatic_execution_authorized": false,
    "missing_authority_may_be_synthesized": false
  },
  "next_decision": "AUTHORIZE_METALS_TACTICAL_POLICY_V2_HISTORICAL_EXPANSION_FEASIBILITY_AUDIT"
}
