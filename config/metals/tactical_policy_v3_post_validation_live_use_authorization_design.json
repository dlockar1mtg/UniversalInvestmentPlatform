    "allowed_interpretation": {
      "TACTICAL_SUPPORTIVE": "Validated evidence that current regime conditions are relatively more supportive for the governed Metals opportunity than the defensive regime state.",
      "TACTICAL_DEFENSIVE": "Validated evidence that current regime conditions are relatively more defensive for the governed Metals opportunity than the supportive regime state.",
      "NO_TACTICAL_OVERLAY": "No directional tactical overlay should be applied because the governed regime is neutral, uncertain, or otherwise does not satisfy a directional state."
    },
    "not_a_buy_signal": true,
    "not_a_sell_signal": true,
    "not_position_sizing": true,
    "not_portfolio_allocation": true,
    "not_expected_return_forecast": true,
    "not_long_term_thesis": true,
    "not_medium_term_opportunity_score": true,
    "not_risk_override": true
  },
  "planned_uip_interpretation_chain": [
