    "forecast_authority": "Certified raw expected-return evidence and forecast horizon.",
    "uncertainty_adjusted_forecast": "Separately typed vehicle uncertainty-adjusted return evidence; not interchangeable with the native recommendation.",
    "risk_authority": "Native typed vehicle risk where present, or separately typed commodity forecast/regime risk context where authorized; semantics must remain distinct.",
    "timing_state": "Bounded tactical interpretation only; supportive, neutral/no-overlay, defensive, unavailable, or not-applicable; never the primary long-term decision."
  },
