    "vehicle_bearish_sign_conflict_rule": "WHEN_GOVERNED_UIP_NORMALIZED_VEHICLE_ACTION_IS_SELL_OR_STRONG_SELL_BUT_CERTIFIED_UNCERTAINTY_ADJUSTED_EXPECTED_RETURN_IS_POSITIVE_CAP_FINAL_ACTION_AT_WATCH",
    "missing_adjusted_evidence_rule": "DO_NOT_INVENT_AN_ADJUSTED_OVERRIDE_WHEN_ADJUSTED_EVIDENCE_IS_UNAVAILABLE_USE_GOVERNED_UIP_NORMALIZED_ACTION_AND_DISCLOSE_MISSING_EVIDENCE",
