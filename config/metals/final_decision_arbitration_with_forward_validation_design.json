    "vehicle_no_conflict_rule": "WHEN_GOVERNED_UIP_NORMALIZED_VEHICLE_ACTION_AND_UNCERTAINTY_ADJUSTED_DIRECTION_DO_NOT_CONFLICT_USE_GOVERNED_UIP_NORMALIZED_ACTION_AS_FINAL_ACTION",
