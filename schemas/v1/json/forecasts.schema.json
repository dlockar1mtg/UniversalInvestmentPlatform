{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiip.local/schemas/v1/forecasts.schema.json",
  "title": "UIIP Forecasts v1",
  "description": "One forecasts record conforming to Universal Data Contracts 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "platform_id",
    "run_id",
    "universal_asset_id",
    "forecast_origin_date",
    "forecast_horizon_months",
    "forecast_date",
    "forecast_method",
    "generated_at_utc"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Universal contract version",
      "examples": [
        "1.0.0"
      ],
      "const": "1.0.0"
    },
    "platform_id": {
      "type": "string",
      "description": "Source platform identifier",
      "examples": [
        "crypto"
      ]
    },
    "run_id": {
      "type": "string",
      "description": "Originating run identifier",
      "examples": [
        "53807130-a90a-4570-ba75-18b17e88ee5d"
      ]
    },
    "universal_asset_id": {
      "type": "string",
      "description": "Universal asset identifier",
      "examples": [
        "crypto:bitcoin"
      ],
      "pattern": "^[a-z0-9]+(?:[:][a-z0-9-]+)+$"
    },
    "forecast_origin_date": {
      "type": "string",
      "format": "date",
      "description": "Date the forecast begins",
      "examples": [
        "7/16/2026"
      ]
    },
    "forecast_horizon_months": {
      "type": "integer",
      "description": "Forecast horizon in months",
      "examples": [
        "36"
      ]
    },
    "forecast_date": {
      "type": "string",
      "format": "date",
      "description": "Forecast endpoint date",
      "examples": [
        "7/16/2029"
      ]
    },
    "current_value": {
      "type": "number",
      "description": "Value at forecast origin",
      "examples": [
        "118500"
      ]
    },
    "forecast_value_base": {
      "type": "number",
      "description": "Base-case projected value",
      "examples": [
        "175000"
      ]
    },
    "forecast_value_bear": {
      "type": "number",
      "description": "Bear-case projected value",
      "examples": [
        "85000"
      ]
    },
    "forecast_value_bull": {
      "type": "number",
      "description": "Bull-case projected value",
      "examples": [
        "260000"
      ]
    },
    "expected_total_return": {
      "type": "number",
      "description": "Expected total return as decimal",
      "examples": [
        "0.4768"
      ]
    },
    "expected_cagr": {
      "type": "number",
      "description": "Expected annualized return as decimal",
      "examples": [
        "0.1383"
      ]
    },
    "probability_positive_return": {
      "type": "number",
      "description": "Probability from 0 to 1",
      "examples": [
        "0.74"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "forecast_confidence": {
      "type": "number",
      "description": "Confidence from 0 to 100",
      "examples": [
        "78"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "forecast_method": {
      "type": "string",
      "description": "Forecast methodology",
      "examples": [
        "monte_carlo"
      ]
    },
    "scenario_name": {
      "type": "string",
      "description": "Named scenario",
      "examples": [
        "base"
      ]
    },
    "model_version": {
      "type": "string",
      "description": "Forecast model version",
      "examples": [
        "3.3.4"
      ]
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Generation timestamp",
      "examples": [
        "2026-07-16T18:06:30Z"
      ]
    }
  }
}
